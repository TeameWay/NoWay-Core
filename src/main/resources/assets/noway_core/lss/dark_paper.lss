// ─────────────────────────────────────────────────────────────────────────────
//  Dark Paper — the paper layout in a dark palette, for NoWay-Core.
//
//  Derived from LDLib2's paper.lss: every selector is kept, only the palette is
//  inverted. Paper's structure notes still apply, so read them in the original.
//
//  PALETTE                                    GEOMETRY
//  bg        #171a1f  canvas, wells           radius  3  slots, bars, tracks
//  surface   #1e222a  panels, menus           radius  5  controls
//  raised    #252a33  controls at rest        radius  7  surfaces
//  hovered   #2d323d  controls under cursor   border  1  hairline, never heavier
//  sunken    #252a33  inputs, viewports       height 16  controls
//  line      #1fffffff  hairline (12% white)
//  line+     #33ffffff  emphasis (20% white)
//  text      #e4e8ef    dim #9aa6b8    faint #6b7686
//  accent    #5c86f8    hover #7aa0ff  press #4468d0   wash #3a5c86f8
//
//  The inversion is not a byte-for-byte flip. Surfaces were mapped by role
//  (canvas -> surface -> raised keeps its ordering) and hairlines swapped from
//  black to white at the same alpha, but two values needed adjusting:
//
//  • #14000000 (8% black) became #24ffffff (14% white). The same alpha of white
//    reads weaker over a dark surface than black does over a light one; at 1px
//    an 8% white line is invisible.
//  • The accent keeps paper's hue and gains lightness. #3b6ef6 on #171a1f is
//    about 3.4:1, which fails normal text; #5c86f8 reaches about 6.1:1.
//
//  ⚠️ Corner radii read (bottom-left, bottom-right, top-right, top-left) —
//  the reverse of the CSS order. A title bar wants "0 0 r r", a footer "r r 0 0".
//
//  An accent is a statement, so it is spent only where the UI has something to
//  say: focus, selection, an on switch, a filled bar. Everything else is grey,
//  and stays out of the way.
// ─────────────────────────────────────────────────────────────────────────────

// ── surfaces ─────────────────────────────────────────────────────────────────
.panel_bg {
  background: sdf(#f2171a1f, 7, 1, #1fffffff);
  padding-all: 6;
  gap-all: 5;
}

.preview_bg {
  background: sdf(#171a1f, 6, 1, #1fffffff);
  padding-all: 4;
}

.configurator_preview_bg {
  background: sdf(#171a1f, 6, 1, #1fffffff);
  padding-all: 4;
}

// ── type ─────────────────────────────────────────────────────────────────────
text, label {
  text-shadow: false;
  text-color: #e4e8ef;
  font: ldlib2:jetbrains_mono_bold;
}

// ── button ───────────────────────────────────────────────────────────────────
// Neutral by default. A screen full of accent-coloured buttons reads as a toy;
// the accent is kept for the confirm button, where it means something.
button:host {
  base-background: sdf(#252a33, 5, 1, #1fffffff);
  hover-background: sdf(#2d323d, 5, 1, #33ffffff);
  pressed-background: sdf(#171a1f, 5, 1, #33ffffff);
  padding-all: 3;
  height: 16;
}

// Icons authored white are already legible on this theme's dark buttons, so the
// white_icon hint leaves them alone instead of tinting them to the label ink.
button:host > .__white_icon__,
button.__white_icon__ > .__icon__ {
  color: #ffffff;
}

button:host .__button_text__ {
  text-color: #e4e8ef;
  text-shadow: false;
}

button:disabled:host {
  base-background: sdf(#2a2e37, 5, 1, #24ffffff);
}

button:disabled:host .__button_text__ {
  text-color: #6b7686;
  text-shadow: false;
}

.__confirm-button__ {
  base-background: sdf(#5c86f8, 5);
  hover-background: sdf(#7aa0ff, 5);
  pressed-background: sdf(#4468d0, 5);
}

.__confirm-button__ .__button_text__ {
  text-color: #171a1f;
}

.__reject-button__ {
  base-background: sdf(#f2555a, 5);
  hover-background: sdf(#ff7579, 5);
  pressed-background: sdf(#d94a50, 5);
}

.__reject-button__ .__button_text__ {
  text-color: #171a1f;
}

// ── text input ───────────────────────────────────────────────────────────────
// ⚠️ Fields draw their own text, so `text, label` never reaches it, and TEXT_COLOR
// defaults to white with CURSOR_COLOR near it. Set without :host on purpose: that
// pseudo matches only elements which are not internal to another component, so a
// colour selector's own fields are outside it — which is how they came out white
// on white. Only the colours are set here; the frame stays with the rules below,
// which are :host so that a component styling its own field keeps control of it.
text-field, text-area {
  text-color: #e4e8ef;
  cursor-color: #e4e8ef;
  text-shadow: false;
}

text-field:host,
.__tag-field_text-field__,
.__search-component_text-field__ {
  background: sdf(#252a33, 5, 1, #1fffffff);
  focus-overlay: sdf(#00000000, 5, 1, #5c86f8);
  padding-all: 3;
  font: ldlib2:jetbrains_mono_bold;
}

search-component:host {
  background: sdf(#252a33, 5, 1, #1fffffff);
  focus-overlay: sdf(#00000000, 5, 1, #5c86f8);
  height: 16;
}

// ── switch ───────────────────────────────────────────────────────────────────
switch:host {
  base-background: sdf(#2d323d, 6);
  pressed-background: sdf(#5c86f8, 6);
  unmark-background: sdf(#9aa6b8, 5);
  mark-background: sdf(#171a1f, 5);
  height: 12;
  width: 22;
  padding-all: 1;
}

// ── selector ─────────────────────────────────────────────────────────────────
selector:host {
  background: sdf(#252a33, 5, 1, #1fffffff);
  focus-overlay: sdf(#00000000, 5, 1, #5c86f8);
  height: 16;
}

selector:host:hovered {
  background: sdf(#2d323d, 5, 1, #33ffffff);
}

.__selector_button-icon__ {
  background: sprite(ldlib2:textures/gui/down.png) scale(0.55) color(#9aa6b8);
}

.__selector_dialog__, .__search-component_dialog__ {
  background: sdf(#f21e222a, 7, 1, #33ffffff);
  padding-all: 3;
}

// ── progress bar ─────────────────────────────────────────────────────────────
progress-bar:host {
  height: 8;
}

progress-bar:host label {
  font-size: 6;
  text-color: #e4e8ef;
  font: ldlib2:jetbrains_mono_bold;
}

.__progress-bar_bar-container__ {
  background: sdf(#252a33, 4, 1, #1fffffff);
  padding-all: 0;
}

.__progress-bar_bar__ {
  background: sdf(#5c86f8, 4);
  padding-all: 0;
}

// ── slots ────────────────────────────────────────────────────────────────────
item-slot, .item-slot_bg {
  background: sdf(#252a33, 4, 1, #1fffffff);
  hover-overlay: sdf(#24ffffff, 4);
}

fluid-slot, .fluid-slot_bg {
  background: sdf(#252a33, 4, 1, #1fffffff);
}

// ── colour selector ──────────────────────────────────────────────────────────
color-selector:host text-field {
  background: sdf(#252a33, 5, 1, #1fffffff);
  focus-overlay: sdf(#00000000, 5, 1, #5c86f8);
  padding-all: 3;
  font: ldlib2:jetbrains_mono_bold;
}

color-selector:host button {
  base-background: sdf(#252a33, 4, 1, #1fffffff);
  hover-background: sdf(#2d323d, 4, 1, #33ffffff);
  pressed-background: sdf(#171a1f, 4, 1, #33ffffff);
}

color-selector:host .__color-selector_alpha-slider__ {
  background: sdf(#252a33, 4, 1, #1fffffff);
  margin-right: 3;
  padding-all: 2;
}

color-selector:host .__color-selector_color-slider__ {
  background: sdf(#252a33, 4, 1, #1fffffff);
  margin-bottom: 3;
  padding-all: 2;
}

color-selector:host .__color-selector_color-preview__ {
  background: sdf(#252a33, 4, 1, #1fffffff);
  margin-right: 3;
  margin-bottom: 3;
  padding-all: 2;
}

// ── toggle ───────────────────────────────────────────────────────────────────
toggle:host {
  mark-background: sdf(#3a5c86f8, 4, 1, #5c86f8);
  height: 14;
}

.__toggle_button__ {
  base-background: sdf(#252a33, 4, 1, #1fffffff);
  hover-background: sdf(#2d323d, 4, 1, #33ffffff);
  pressed-background: sdf(#171a1f, 4, 1, #33ffffff);
}

toggle:on .__toggle_button__ {
  base-background: sdf(#3a5c86f8, 4, 1, #5c86f8);
  hover-background: sdf(#555c86f8, 4, 1, #7aa0ff);
  pressed-background: sdf(#3a4468d0, 4, 1, #5c86f8);
}

.__toggle_mark-icon__ {
  margin-all: 2;
  width: auto;
  height: auto;
  flex: 1;
}

// ── text area ────────────────────────────────────────────────────────────────
text-area {
  scroller-view-margin: 8;
  font: ldlib2:jetbrains_mono_bold;
}

text-area:host {
  focus-overlay: sdf(#00000000, 5, 1, #5c86f8);
}

// The tree's arrows ship as white sprites. They stay visible on a dark row, but
// they are tinted to the dim ink so they do not out-shout the label beside them.
tree-list {
  collapse-icon: sprite(ldlib2:textures/gui/icon/gdp_icons.png, 188, 240, 5, 5) color(#9aa6b8);
  expand-icon: sprite(ldlib2:textures/gui/icon/gdp_icons.png, 132, 230, 5, 5) color(#9aa6b8);
}

.__text-area_content-view__ {
  background: sdf(#252a33, 5, 1, #1fffffff);
  padding-all: 3;
}

.__text-area_horizontal-scroller__ {
  height: 5;
  margin-top: 2;
}

.__text-area_vertical-scroller__ {
  width: 5;
  margin-left: 2;
}

// ── scrollers ────────────────────────────────────────────────────────────────
// Rail and thumb only. The end buttons are gone: nobody has clicked a scrollbar
// arrow since the mouse wheel, and they cost two chunks of every scroller.
scroller-horizontal:host {
  height: 5;
}

scroller-vertical:host {
  width: 5;
}

.__scroller_scroll_container__ {
  background: sdf(#24ffffff, 3);
  padding-all: 0;
}

scroller-horizontal .__scroller_scroll_bar__,
scroller-vertical .__scroller_scroll_bar__ {
  base-background: sdf(#40ffffff, 3);
  hover-background: sdf(#73ffffff, 3);
  pressed-background: sdf(#5c86f8, 3);
}

.__scroller_head_button__, .__scroller_tail_button__ {
  display: none;
}

scroller-view {
  scroller-view-margin: 8;
}

.__scroller_view_view-port__ {
  background: sdf(#252a33, 5, 1, #1fffffff);
  padding-all: 3;
}

.__scroller_view_horizontal-scroller__ {
  height: 5;
  margin-top: 2;
}

.__scroller_view_vertical-scroller__ {
  width: 5;
  margin-left: 2;
}

// ── slider ───────────────────────────────────────────────────────────────────
slider-horizontal:host {
  height: 10;
}

slider-vertical:host {
  width: 10;
}

slider-horizontal, slider-vertical {
  slider-track-size: 3;
  slider-handle-size: 5;
}

.__slider_track__ {
  background: sdf(#252a33, 2, 1, #1fffffff);
}

.__slider_fill__ {
  background: sdf(#5c86f8, 2);
}

.__slider_handle__ {
  base-background: sdf(#e4e8ef, 3);
  hover-background: sdf(#5c86f8, 3);
  pressed-background: sdf(#4468d0, 3);
}

// ── tabs ─────────────────────────────────────────────────────────────────────
// The header is the same surface as the content, joined by one seam, so a tab
// strip reads as one card rather than as a lid resting on a box.
.__tab-view_tab_header_container__ {
  background: sdf(#252a33, 7 7 0 0, 1, #1fffffff);
  margin-bottom: -1;
  padding-all: 3;
}

.__tab-view_tab_header_container__ .__scroller_view_view-container__ {
  gap-all: 3;
}

.__tab-view_tab_content_container__ {
  background: sdf(#1e222a, 0 0 7 7, 1, #1fffffff);
}

tab-view .__tab-view_tab_scroller__ {
  margin-bottom: 0;
}

tab:host {
  base-background: empty;
  hover-background: sdf(#1fffffff, 5);
  pressed-background: sdf(#3a5c86f8, 5);
  padding-all: 3;
  height: 16;
}

tab:host:selected {
  base-background: sdf(#1e222a, 5 5 0 0);
  hover-background: sdf(#1e222a, 5 5 0 0);
  pressed-background: sdf(#1e222a, 5 5 0 0);
}

tab:host:not(tab:selected) label {
  text-color: #9aa6b8;
  text-shadow: false;
}

// ── dialog ───────────────────────────────────────────────────────────────────
.__dialog_title__ {
  background: sdf(#252a33, 7 7 0 0, 1, #33ffffff);
  transform: translateY(1);
}

.__dialog_title__ > label {
  text-color: #e4e8ef;
}

.__dialog_content-container__ {
  background: sdf(#f21e222a, 0, 1, #33ffffff);
}

.__dialog_button-container__ {
  background: sdf(#f21e222a, 0 0 7 7, 1, #33ffffff);
  transform: translateY(-1);
}

// ── menu ─────────────────────────────────────────────────────────────────────
menu {
  background: sdf(#f21e222a, 6, 1, #33ffffff);
  arrow: sprite(ldlib2:textures/gui/right.png) scale(0.55) color(#9aa6b8);
}

// ── editor ───────────────────────────────────────────────────────────────────
.__editor__ code-editor {
  background: sdf(#0f1115, 6, 1, #33ffffff);
}

.__editor_top__ {
  background: sdf(#252a33, 6 6 0 0);
}

.__editor__ button:host {
  base-background: sdf(#00000000, 5, 1, #1fffffff);
  hover-background: sdf(#1fffffff, 5, 1, #33ffffff);
  pressed-background: sdf(#3a5c86f8, 5, 1, #5c86f8);
}

.__editor__ tab:host {
  height: 15;
}

.__editor-gizmo-bar__ {
  background: sdf(#f2171a1f, 6, 1, #33ffffff);
}

.__view-container__ {
  background: sdf(#171a1f);
}

.__view-container_tab-view__ .__tab-view_tab_content_container__ {
  padding-all: 3;
}

.__view-container_collapse-button__ {
  height: 14;
  width: 14;
}

ResourceView .__tab-view_tab_header_container__ .__scroller_view_view-container__ {
  gap-all: 2;
}

ResourceView tab:host {
  base-background: empty;
  hover-background: sdf(#1fffffff, 5) scale(0.92);
  pressed-background: sdf(#3a5c86f8, 5) scale(0.92);
}

ResourceView tab:host:selected {
  base-background: sdf(#1e222a, 5) scale(0.92);
  hover-background: sdf(#252a33, 5) scale(0.92);
  pressed-background: sdf(#252a33, 5) scale(0.92);
}

/* One rounded shape cut in two: the strip rounds the corners facing away from the content, the
   content rounds the ones facing away from the strip, and each is nudged a pixel into the other so
   the two borders read as one seam. Which corners those are turns with the placement — and mind the
   radius order, which is top-left, top-right, bottom-right, bottom-left. */
.__resource-view_placement-left__ .__tab-view_tab_header_container__ {
  background: sdf(#171a1f, 7 0 0 7, 1, #1fffffff);
  transform: translate(1, 0);
}

.__resource-view_placement-left__ .__tab-view_tab_content_container__ {
  background: sdf(#1e222a, 0 7 7 0, 1, #1fffffff);
}

.__resource-view_placement-right__ .__tab-view_tab_header_container__ {
  background: sdf(#171a1f, 0 7 7 0, 1, #1fffffff);
  transform: translate(-1, 0);
}

.__resource-view_placement-right__ .__tab-view_tab_content_container__ {
  background: sdf(#1e222a, 7 0 0 7, 1, #1fffffff);
}

.__resource-view_placement-top__ .__tab-view_tab_header_container__ {
  background: sdf(#171a1f, 7 7 0 0, 1, #1fffffff);
  transform: translate(0, 1);
}

.__resource-view_placement-top__ .__tab-view_tab_content_container__ {
  background: sdf(#1e222a, 0 0 7 7, 1, #1fffffff);
}

.__resource-view_placement-bottom__ .__tab-view_tab_header_container__ {
  background: sdf(#171a1f, 0 0 7 7, 1, #1fffffff);
  transform: translate(0, -1);
}

.__resource-view_placement-bottom__ .__tab-view_tab_content_container__ {
  background: sdf(#1e222a, 7 7 0 0, 1, #1fffffff);
}

.__resource-view_tab-placeholder__ {
  background: sdf(#3a5c86f8, 5);
}

.__ui-editor-view_header__ {
  background: sdf(#1e222a);
}

.__ui-editor-view_header__ button {
  height: 14;
}

.__ui-editor-view_header__ .__toggle_button__ {
  base-background: sdf(#00000000, 4, 1, #1fffffff);
  hover-background: sdf(#1fffffff, 4, 1, #33ffffff);
  pressed-background: sdf(#3a5c86f8, 4, 1, #5c86f8);
}

.__ui-editor-view_canvas__ {
  background: #171a1f;
}

.__ui-editor-view_builtin-styles-toggle__ {
  height: 14;
  padding-all: 0;
  mark-background: sdf(#00000000, 4, 1, #5c86f8);
}

.__ui-editor-view_builtin-styles-toggle__ .__toggle_button__ {
  base-background: sdf(#00000000, 4, 1, #1fffffff);
  hover-background: sdf(#1fffffff, 4, 1, #33ffffff);
}

.__ui-editor-view_builtin-styles-toggle__ .__toggle_mark-icon__ {
  margin-all: 0;
}

.__ui-editor-view_style-view__ {
  background: empty;
  gap-all: 3;
}

.__editor-window_active__ {
  background: #5c86f8;
}

.__editor-window_inactive__ {
  background: #252a33;
}

// ── configurator ─────────────────────────────────────────────────────────────
.__configurator-group__ .__configurator-group_container__ {
  background: sdf(#1e222a, 0 6 6 6, 1, #1fffffff);
}

.__configurator-group__ > .__configurator_line__ {
  background: sdf(#171a1f, 5, 1, #1fffffff);
}

.__configurator-group__ > .__configurator_line__:hovered:not(:disabled) {
  background: sdf(#252a33, 5, 1, #33ffffff);
}

.__configurator-group__ > .__configurator_line__ > .__configurator_label__ {
  text-color: #9aa6b8;
  text-shadow: false;
}

ToggleSelectorConfigurator .__toggle_mark-icon__ {
  margin-all: 0;
}

ToggleSelectorConfigurator .__toggle_button__ {
  base-background: sdf(#00000000, 4, 1, #1fffffff);
  hover-background: sdf(#1fffffff, 4, 1, #33ffffff);
  pressed-background: sdf(#3a5c86f8, 4, 1, #5c86f8);
}

.__array-configurator_button-group__ {
  background: sdf(#00000000, 5, 1, #1fffffff);
  padding-all: 2;
}

.__array-configurator_item_selected__ {
  background: sdf(#3a5c86f8, 4, 1, #5c86f8);
}

// ── node graph ───────────────────────────────────────────────────────────────
.__blackboard-var-prop_title-bar__ {
  background: sdf(#252a33, 6 6 0 0, 1, #1fffffff);
}

.__blackboard-var-prop_content__ {
  background: sdf(#1e222a, 0 0 6 6, 1, #1fffffff);
}

.__node-graph-view_canvas__ {
  background: #23272f;
}

.__node-graph-view_canvas-view__ {
  color: #7d8798;
}

.__node-element__ {
  background: sdf(#f2171a1f, 6, 1, #33ffffff);
}

.__node-title-element__ {
  background: sdf(#252a33, 6 6 0 0, 1, #1fffffff);
  padding-bottom: 4;
}

.__node-port-container__ {
  background: sdf(#00000000, 0 0 6 6);
}

.__in-out-port-container_input__ {
  background: sdf(#00000000);
  margin-all: 1;
}

.__in-out-port-container_output__ {
  background: sdf(#24ffffff);
  margin-all: 1;
}

.__capsule-node__ {
  background: sdf(#fa252a33, 8, 1, #33ffffff);
}

.__capsule-node__ .__node-title-element__ {
  background: empty;
  padding-bottom: 0;
}

.__capsule-node__ .__node-port-container__ {
  background: empty;
}

.__context-node__ > .__node-title-element__ {
  height: 30;
  gap-all: 5;
}

.__block-node__ > .__node-title-element__ {
  background: sdf(#3a5c86f8, 6 6 0 0, 1, #5c86f8);
}

.__block-list-container__ {
  background: sdf(#252a33, 6);
}

.__subgraph-node__ .__node-title-element__ {
  background: sdf(#2d323d, 6 6 0 0, 1, #33ffffff);
}

.__vertical-port-container__ {
  padding-all: 2;
  gap-all: 4;
}

.__vertical-port__ {
  padding-all: 1;
}

.__node-preview__ {
  background: sdf(#252a33, 0 0 6 6, 1, #1fffffff);
  padding-all: 3;
}

.__item-library__ {
  background: sdf(#f21e222a, 7, 1, #5c86f8);
}

.__item-library_description-panel__ {
  background: sdf(#f2171a1f, 7, 1, #1fffffff);
  padding-all: 6;
  gap-all: 5;
}

// ── keymap ──────────────────────────────────────────────────────────────────
.__keymap_chord__ {
  background: sdf(#252a33, 5, 1, #1fffffff);
}

.__keymap_chord__:hovered {
  background: sdf(#2a2e37, 5, 1, #33ffffff);
}

.__keymap_chord__.__capturing__ {
  background: sdf(#252a33, 5, 1, #5c86f8);
}

.__keymap_chord-text__ {
  text-color: #e4e8ef;
  text-shadow: false;
}

.__keymap_chord__.__conflict__ .__keymap_chord-text__ {
  text-color: #e0313f;
}

// ── NoWay-Core components ────────────────────────────────────────────────────
//
// Everything above comes from paper and is theme-wide. The rules below are the
// modules this mod adds; they are kept in one block so a future paper update can
// be re-merged without hunting for them.

// Thread card on the controller screen. Selecting a card only swaps the class,
// so the three states have to differ in fill and border at once — hover alone
// would be indistinguishable from selected.
.controller-thread-card {
  background: sdf(#252a33, 3, 1, #1fffffff);
}

.controller-thread-card:hover {
  background: sdf(#2d323d, 3, 1, #33ffffff);
}

.controller-thread-card.controller-thread-selected {
  background: sdf(#3a5c86f8, 3, 1, #5c86f8);
}

// Rules between the panes of the controller screen: one vertical between the two
// columns, two horizontal inside the left column (machine info / recipe /
// inventory). One pixel wide, so it is a plain rect rather than an sdf — a
// radius cannot show at this size.
.controller-divider {
  background: rect(#33ffffff);
}

// Port list floating over the controller screen. It sits above the panes and can
// be dragged anywhere, so it needs its own surface and a slightly heavier border
// than a card — otherwise it reads as one more row of the page behind it.
.port-panel {
  background: sdf(#1e222a, 4, 1, #40ffffff);
  z-index: 10;
}

.port-panel-title {
  background: sdf(#252a33, 3);
}

.port-panel-card {
  background: sdf(#252a33, 3, 1, #1fffffff);
  z-index: 1;
}

.port-panel-card:hover {
  background: sdf(#2d323d, 3, 1, #33ffffff);
}
